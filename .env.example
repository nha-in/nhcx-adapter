# Environment for the container image (docker compose reads .env).
# Keep comments on their own lines: `docker run --env-file` does not strip
# trailing ones.

# sandbox | production
NHCX_ENV=sandbox

# Required
NHCX_PARTICIPANT_ID=1000003463@hcx
NHCX_CLIENT_ID=
NHCX_CLIENT_SECRET=
NHCX_CALLBACK_URL=http://host.docker.internal:8765/nhcx/callback

# Optional. The API key is required in production; a panel password of 8+
# characters turns on /panel. Public URL is e.g. https://hcx.example.com/in
NHCX_CALLBACK_API_KEY=
NHCX_PUBLIC_URL=
NHCX_ADAPTER_API_KEY=
NHCX_PANEL_PASSWORD=
NHCX_LOG_LEVEL=info

# Compose only
NHCX_ADAPTER_TAG=latest
NHCX_PORT=8090
